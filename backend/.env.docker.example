# Copy to backend/.env for local Docker: docker compose up --build
PORT=5000
NODE_ENV=development

MONGODB_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@rgipt.ac.in

# Your Vercel URL (for CORS when testing frontend locally against Docker backend)
FRONTEND_URL=http://localhost:5173
PORTAL_URL=http://localhost:5173

PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Redis — Upstash (same URL for local Docker, npm run dev, and Render production)
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379
