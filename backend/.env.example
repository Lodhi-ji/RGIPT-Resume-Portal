PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=development

# SMTP Configuration for Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@rgipt.ac.in

# Portal Configuration
PORTAL_URL=http://localhost:3000
SUPPORT_EMAIL=support@rgipt.ac.in
INSTITUTION_NAME=RGIPT

# Production only (optional)
FRONTEND_URL=https://your-frontend-domain.com
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Redis — Upstash (OTP rate limiting; same pattern as MongoDB Atlas)
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# Demo Credentials (after running seedData.js):
# Admin: admin@rgipt.ac.in / Admin@RGIPT
# Student: priya.sharma@rgipt.ac.in / Pass@123
